// Display layout and display-bound rules belong to this machine.
output "DP-1" {
    scale 1.0
    transform "normal"
    mode "2560x1440@164.956"
    focus-at-startup
}

output "DP-2" {
    scale 1.0
    transform "normal"
    mode "1920x1080@143.981"
    position x=0 y=0
}

workspace "entertainment" {
    open-on-output "DP-1"
}

window-rule {
    match app-id=r#"^brave-browser$"#
    match title="General"
    open-on-output "DP-2"
    open-maximized true
}
